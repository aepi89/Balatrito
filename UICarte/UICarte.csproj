<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
	<TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
  <Resource Include="Foto\**\*.png" /> <!-- Cartelle delle foto -->
  <Resource Include="Foto\**\*.jpg" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Font\mojangles.otf\**" />
    <EmbeddedResource Remove="Font\mojangles.otf\**" />
    <None Remove="Font\mojangles.otf\**" />
    <Page Remove="Font\mojangles.otf\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Font\Minecraft.otf" />
    <None Remove="Lukrembo-Cheese %28freetouse.com%29.mp3" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Lukrembo-Cheese (freetouse.com).mp3">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Font\Minecraft.otf" />
  </ItemGroup>

</Project>
