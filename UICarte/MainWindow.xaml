<Window x:Class="UICarte.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UICarte"
        mc:Ignorable="d"
        Title="Gioco di carte" 
	    Height="630" Width="900">

    <Window.Background>
        <ImageBrush ImageSource="/Foto/Background.jpg"></ImageBrush>
    </Window.Background>


    <Grid Margin="1">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*"/>
            <ColumnDefinition Width="17*"/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <!-- Barra superiore -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="210"/>
            <!-- Spazio per mazzo -->
            <RowDefinition Height="30"/>
            <!-- Spazio per qualche scritta? -->
        </Grid.RowDefinitions>

        <!-- Box punti -->
        <Border 
                CornerRadius="10"
                Grid.Column="1"
                Background="#293133"
                Margin="5"
                Height="90"
                Width="500">

            <GroupBox Header="Punteggio"
                Foreground="White" 
                BorderBrush="White" 
                BorderThickness="1" 
                Margin="7,-2,7,7">

                <Grid>
                    
                    <Grid.ColumnDefinitions>    <!-- Divido la Box in 3 colonne fish, x e Multi. -->
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="5*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Fish -->
                    <Border
                        Grid.Column="0"
                        Background="Blue"
                        Height="40"
                        Width="200"
                        CornerRadius="8"
                        BorderBrush="Transparent"
                        Panel.ZIndex="0">


                        <TextBlock Text="Fish"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="Bold"
                               FontSize="35"/>
                    </Border>

                    <!-- X -->
                    <TextBlock Text="X"
                               Grid.Column="1"
                               Foreground="White"
                               FontSize="40"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Panel.ZIndex="1"
                               Margin="0,0,0,8"/>

                    <!-- Moltiplicatore -->
                    <Border
                        Grid.Column="2"
                        Background="Red"
                        Height="40"
                        Width="200"
                        CornerRadius="8"
                        BorderBrush="Transparent"
                        Panel.ZIndex="0">


                        <TextBlock Text="Multiplier"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="Bold"
                               FontSize="30"/>
                    </Border>

                </Grid>
            </GroupBox>

        </Border>

        <Border
            MaxWidth="252"
            CornerRadius="5"
            Grid.RowSpan="4"
            Background="#293133"
            Margin="5">

            <GroupBox Header="Menù"
                Foreground="White" 
                BorderBrush="White" 
                BorderThickness="1" 
                Margin="10">

                <StackPanel>

                    <!-- Bottone Rosso -->
                    <Border
                        CornerRadius="8"
                        Background="Crimson"
                        BorderThickness="4"
                        BorderBrush="AliceBlue"
                        Margin="5,20,5,0" Height="130">

                        <Button x:Name="BtnInfo"
                            Content="Info"
                            Foreground="White"
                            VerticalContentAlignment="Center"
                            FontWeight="Bold"
                            FontSize="30"
                            BorderThickness="0"
                            Background="Transparent"
                            ToolTip="Bottone"/>
                        
                    </Border>

                    <!-- Bottone Blu -->
                    <Border
                        CornerRadius="8"
                        Background="Blue"
                        BorderThickness="4"
                        BorderBrush="AliceBlue"
                        Margin="5,20,5,0" Height="130">

                        <Button x:Name="BtnScarta"
                            Content="Scarta"
                            Foreground="White"
                            VerticalContentAlignment="Center"
                            FontSize="30"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Background="Transparent"
                            ToolTip="Bottone"/>
                    </Border>

                    <!-- Bottone Verde -->
                    <Border
                        CornerRadius="8"
                        Background="Green"
                        BorderThickness="4"
                        BorderBrush="AliceBlue"
                        Margin="5,20,5,0" Height="130">

                        <Button x:Name="BtnTira"
                            Content="Tira"
                            Foreground="White"
                            VerticalContentAlignment="Center"
                            FontSize="30"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Background="Transparent"
                            ToolTip="Bottone"/>
                        
                    </Border>

                    <!-- Impostazioni -->

                    <Border
                        CornerRadius="8"
                        Background="DarkOrange"
                        BorderThickness="4"
                        BorderBrush="AliceBlue"
                        Margin="5,20,5,0" Height="50">

                        <Button x:Name="BtnImpostazioni"
                            Content="Impostazioni"
                            Foreground="White"
                            VerticalContentAlignment="Center"
                            FontSize="18"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Background="Transparent"
                            ToolTip="Bottone"/>
                        
                    </Border>
                </StackPanel>
            </GroupBox>
        </Border>
        <!-- Fine Menù laterale -->
        
        <!-- Mazzo -->
        <Border
            Grid.Column="2"
            Grid.Row="2"
            CornerRadius="8"
            Background="#293133"
            Opacity="0.7"
            Panel.ZIndex="0"
            Grid.RowSpan="2"
            Margin="5,0,5,15"
            BorderBrush="Transparent">
        </Border>
        
        <Image Source="/Foto/Mazzo.png" 
               Panel.ZIndex="1" 
               Grid.Column="2"
               Grid.Row="2"
               Grid.RowSpan="2"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               MaxHeight="200"
               MaxWidth="340"
               Margin="0,0,0,8"/>

        <TextBlock Text="Mazzo"
                   Grid.Column="2"
                   Grid.Row="1"
                   FontSize="30"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"    
                   Margin="0,0,0,10"
                   Panel.ZIndex="1"/>
        <!-- Fine mazzo -->
        
        <!-- Box delle carte -->
        <Border
            Grid.Column="1"
            Grid.Row="2"
            CornerRadius="8"
            Background="#293133"
            Opacity="0.7"
            Panel.ZIndex="0"
            Grid.RowSpan="2"
            Margin="15,0,15,15"
            BorderBrush="Transparent">
        </Border>
        
        <TextBlock Text="X / 8"
                   Grid.Column="1"
                   Grid.Row="1"
                   FontSize="15"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"    
                   Margin="0,0,30,5"
                   Panel.ZIndex="1"/> <!-- Carte selezionate -->

    </Grid>
</Window>
